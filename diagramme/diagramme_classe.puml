@startuml
skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false


package "fr.eseo.e3e.devlogiciel.etudiant" {
  enum Cursus {
    E1
    E2
    E3e
    E3a
    E4
    E5
  }

  class Etudiant {
    - numeroApprenant : String
    - nom : String
    - prenom : String
    - cursus : Cursus
    + Etudiant()
    + Etudiant(numeroApprenant: String, nom: String, prenom: String, cursus: Cursus)
  }
}

package "fr.eseo.e3e.devlogiciel.epreuve" {
  enum Modalite {
    EXAMEN_ECRIT
    ORAL
    QCM
    SUR_ORDINATEUR
    PROJET
    TP
  }

  class Epreuve {
    - codeECUE : String
    - date : LocalDate
    - heurePassage : LocalTime
    - duree : int
    - modalite : Modalite
    + Epreuve()
    + Epreuve(codeECUE: String, date: LocalDate, heurePassage: LocalTime, duree: int, modalite: Modalite)
  }
}

package "fr.eseo.e3e.devlogiciel.formulaire" {
  class Formulaire {
    - id : int
    - dateCreation : LocalDateTime
    - dateDerniereModification : LocalDateTime
    - epreuve : Epreuve
    - etudiants : List<Etudiant>
    - fraudes : List<Fraude>
    - actualiserDateModification()
    + Formulaire()
    + Formulaire(epreuve: Epreuve, etudiants: List<Etudiant>, fraudes: List<Fraude>)
    + ajouterEtudiant(e: Etudiant)
    + ajouterFraude(f: Fraude)
  }
}

package "fr.eseo.e3e.devlogiciel.journalhistorique" {
  class JournalHistorique {
    - entrees : List<EntreeHistorique>
    + ajouterEntree(description: String)
    + exporterEnTexte(cheminFichier: String)
  }

  class EntreeHistorique {
    - horodatage : LocalDateTime
    - action : String
    + entreeHistorique(action: String)
  }
}

package "fr.eseo.e3e.devlogiciel.fraude" {
  abstract class Fraude {
    - dateReleve : LocalDate
    - description : String
    - contenu : String
    + Fraude()
    + Fraude(dateReleve: LocalDate, description: String, contenu: String)
  }

  class FraudeIAG {
    - nomService : String
    + FraudeIAG()
  }

  class FraudePapier {
    - dimensions : String
    - estPlie : boolean
  }

  class FraudeCalculatrice {
    - marque : String
    - programme : String
  }

  class FraudeIAGConnectee {
    - adresseIP : String
  }
}

package "fr.eseo.e3e.devlogiciel.systeme" {
  class SystemeGestion {
    - formulaires : List<Formulaire>
    - etudiants : List<Etudiant>
    - journal : JournalHistorique
    + SystemeGestion()
    + enregistrerFormulaire(f: Formulaire)
    + supprimerFormulaire(id: int)
    + rechercheCroisee(cursus: Cursus, typeFraude: Class): List<Formulaire>
    + consulterHistorique(): List<EntreeHistorique>
    + sauvegarder(cheminFichier: String)
    + {static} charger(cheminFichier: String): SystemeGestion
  }
}

package "fr.eseo.e3e.devlogiciel.ui" {
  class ConsoleUI {
    - scanner : Scanner
    - systeme : SystemeGestion
    + ConsoleUI(systeme: SystemeGestion)
    + demarrer()
    - afficherMenuPrincipal()
    - saisirNouveauFormulaire()
    - actionSupprimerFormulaire()
    - afficherTousLesFormulaires()
    - actionRechercheCroisee()
    - afficherJournalHistorique()
  }
}

package "fr.eseo.e3e.devlogiciel" {
  class Main {
    - {static} FICHIER_DATA : String
    - {static} CHEMIN_LOGS : String
    + {static} main(args: String[])
  }
}

' --- Relations d'héritage ---
Fraude <|-- FraudeIAG
Fraude <|-- FraudePapier
Fraude <|-- FraudeCalculatrice
FraudeIAG <|-- FraudeIAGConnectee

' --- Relations d'association et composition ---
SystemeGestion "1" *-- "1" JournalHistorique : possède >
JournalHistorique "1" *-- "*" EntreeHistorique : contient >
SystemeGestion "1" o-- "*" Formulaire : gère >

Formulaire "1" --> "1" Epreuve : concerne >
Formulaire "1" --> "1..*" Etudiant : implique >
Formulaire "1" --> "1..*" Fraude : recense >

Etudiant .> Cursus : utilise
Epreuve .> Modalite : utilise

' --- Relations pour l'architecture UI/Main ---
Main ..> SystemeGestion : initialise >
Main ..> ConsoleUI : lance >
ConsoleUI "1" --> "1" SystemeGestion : interagit avec >

@enduml