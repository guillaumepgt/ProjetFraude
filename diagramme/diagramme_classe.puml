@startuml
skinparam classAttributeIconSize 0
skinparam monochrome true
skinparam shadowing false

' --- Énumérations ---
enum Cursus {
  E1
  E2
  E3e
  E3a
  E4
  E5
}

enum Modalite {
  EXAMEN_ECRIT
  ORAL
  QCM
  SUR_ORDINATEUR
  PROJET
  TP
}

' --- Classes du domaine ---
class Etudiant {
  - numeroApprenant : String
  - nom : String
  - prenom : String
  - cursus : Cursus
  + Etudiant()
  + Etudiant(numeroApprenant: String, nom: String, prenom: String, cursus: Cursus)
}

class Epreuve {
  - codeECUE : String
  - date : LocalDate
  - heurePassage : LocalTime
  - duree : int
  - modalite : Modalite
  + Epreuve()
  + Epreuve(codeECUE: String, date: LocalDate, heurePassage: LocalTime, duree: int, modalite: Modalite)
}

class Formulaire {
  - id : int
  - dateCreation : LocalDateTime
  - dateDerniereModification : LocalDateTime
  - epreuve : Epreuve
  - etudiants : List<Etudiant>
  - fraudes : List<Fraude>
  - actualiserDateModification()
  + Formulaire()
  + Formulaire(epreuve: Epreuve, etudiants: List<Etudiant>, fraudes: List<Fraude>)
  + ajouterEtudiant(e: Etudiant)
  + ajouterFraude(f: Fraude)
}

' --- Système de Gestion et Traçabilité ---
class SystemeGestion {
  - formulaires : List<Formulaire>
  - etudiants : List<Etudiant>
  - journal : JournalHistorique
  + enregistrerFormulaire(f: Formulaire)
  + supprimerFormulaire(id: int)
  + rechercheCroisee(cursus: Cursus, typeFraude: Class): List<Formulaire>
  + consulterHistorique(): List<EntreeHistorique>
}

class JournalHistorique {
  - entrees : List<EntreeHistorique>
  + ajouterEntree(description: String)
  + exporterEnTexte(cheminFichier: String)
}

class EntreeHistorique {
  - horodatage : LocalDateTime
  - action : String
  + entreeHistorique(action: String)
}

' --- Hiérarchie des Fraudes ---
abstract class Fraude {
  - dateReleve : LocalDate
  - description : String
  - contenu : String
  + Fraude()
  + Fraude(dateReleve: LocalDate, description: String, contenu: String)
}

class FraudeIAG {
  - nomService : String
  + FraudeIAG()
}

class FraudePapier {
  - dimensions : String
  - estPlie : boolean
}

class FraudeCalculatrice {
  - marque : String
  - programme : String
}

class FraudeIAGConnectee {
  - adresseIP : String
}

' --- Relations ---
Fraude <|-- FraudeIAG
Fraude <|-- FraudePapier
Fraude <|-- FraudeCalculatrice
FraudeIAG <|-- FraudeIAGConnectee

SystemeGestion "1" *-- "1" JournalHistorique : possède >
JournalHistorique "1" *-- "*" EntreeHistorique : contient >
SystemeGestion "1" o-- "*" Formulaire : gère >

Formulaire "1" --> "1" Epreuve : concerne >
Formulaire "1" --> "1..*" Etudiant : implique >
Formulaire "1" --> "1..*" Fraude : recense >

Etudiant .> Cursus : utilise
Epreuve .> Modalite : utilise
@enduml